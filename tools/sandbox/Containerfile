FROM docker.io/library/archlinux:latest
# All packages are installed in the image, never on the host.
RUN printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf && \
    pacman -Syu --needed --noconfirm dotnet-sdk-9.0 git rsync tar gzip zstd \
      steam lib32-openssl lib32-curl lib32-mesa lib32-vulkan-swrast \
      mesa vulkan-swrast gtk3 libnotify libice libsm dbus gnome-keyring libsecret \
      tigervnc openbox xterm xorg-xdpyinfo xorg-xmessage ttf-dejavu firefox \
      python python-pip curl ca-certificates && \
    python -m venv /opt/websockify && \
    /opt/websockify/bin/pip install --no-cache-dir websockify==0.13.0 && \
    curl -fL --retry 3 https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz | \
      tar -xz -C /opt && mv /opt/noVNC-1.7.0 /opt/novnc && \
    pacman -Scc --noconfirm
ARG SLS_VERSION=20261014151919
ARG LUMA_VERSION=v0.22.4
RUN curl -fL --retry 3 "https://github.com/AceSLS/SLSsteam/releases/download/${SLS_VERSION}/SLSsteam-Arch-release-x86_64.pkg.tar.zst" -o /tmp/sls.pkg.tar.zst && \
    pacman -U --noconfirm /tmp/sls.pkg.tar.zst && rm /tmp/sls.pkg.tar.zst && \
    install -d /usr/lib/lumalinux && \
    curl -fL --retry 3 "https://github.com/jayool/lumalinux/releases/download/${LUMA_VERSION}/liblumalinux.so" -o /usr/lib/lumalinux/liblumalinux.so && \
    useradd -m -u 1000 -s /bin/bash dev && \
    install -d -o dev -g dev /home/dev /run/user/1000 && \
    chmod 700 /run/user/1000
# FST's existing loader discovery uses this directory and these filenames.
RUN install -d /usr/lib/SLSsteam && \
    ln -s /usr/lib32/libSLSsteam.so /usr/lib/SLSsteam/SLSsteam.so && \
    ln -s /usr/lib32/libSLS-library-inject.so /usr/lib/SLSsteam/library-inject.so
COPY session.sh control.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/session.sh /usr/local/bin/control.sh
ENV HOME=/home/dev DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/1000 \
    XDG_CONFIG_HOME=/home/dev/.config XDG_DATA_HOME=/home/dev/.local/share \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 LIBGL_ALWAYS_SOFTWARE=1
USER dev
WORKDIR /home/dev
ENTRYPOINT ["/usr/local/bin/session.sh"]
