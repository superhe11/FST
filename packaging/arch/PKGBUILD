# Build from the local release archive: makepkg -si
pkgname=fast-steam-tools-bin
pkgver=0.1.3
pkgrel=1
pkgdesc='Fast Steam Tools desktop client for native Steam on Linux'
arch=('x86_64')
license=('custom')
depends=('python' 'glibc' 'gcc-libs' 'icu' 'openssl' 'zlib' 'libx11' 'libice' 'libsm' 'fontconfig' 'libsecret' 'xdg-utils' 'ttf-dejavu')
optdepends=('gnome-keyring: Secret Service keyring provider' 'slssteam: native Steam library integration' 'xorg-xwayland: display on Wayland desktops')
provides=('fst')
conflicts=('fast-steam-tools')
source=("fst-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('REPLACE_WITH_RELEASE_SHA256')
package() {
  install -Dm755 "$srcdir/fst-linux-x64/app/fst" "$pkgdir/opt/fst/fst"
  install -Dm644 "$srcdir/fst-linux-x64/fst.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fst.svg"
  install -Dm644 "$srcdir/fst-linux-x64/fst.desktop" "$pkgdir/usr/share/applications/fst.desktop"
  install -Dm755 "$srcdir/fst-linux-x64/fst-launcher" "$pkgdir/usr/bin/fst"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  cp "$srcdir/fst-linux-x64/LICENSES/"* "$pkgdir/usr/share/licenses/$pkgname/"
}
